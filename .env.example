# Rate the Bakchod — environment
#
# Copy to `.env.local` and fill in. Never commit `.env.local`, and never paste
# these values into a chat window or an issue.
#
#   cp .env.example .env.local
#
# `.env.local` is read by `next dev`/`next build`; the Prisma CLI reads it via
# the dotenv call in prisma.config.ts.

# ─── Database (Supabase → Connect) ───────────────────────────────────────────
# Prisma needs both. The app queries through DATABASE_URL; migrations use
# DIRECT_URL, which must be a session-mode connection because PgBouncer in
# transaction mode cannot run DDL inside a transaction.
#
# Use the POOLER host for both. Supabase's direct host, db.<project-ref>.supabase.co,
# publishes an IPv6 address and no IPv4 one — on an IPv4-only network it does not
# resolve at all and Prisma reports P1001 "can't reach database server", which
# looks like an outage rather than a routing problem. The pooler is dual-stack.
# `npm run check-env` fails on this combination rather than letting you find out
# from migrate deploy.
#
# Both pooler strings authenticate as postgres.<project-ref> — note the dot. A
# plain `postgres` username there fails with "Tenant or user not found".
#
# Transaction pooler, port 6543. `connection_limit=1` is deliberate: with a
# pooler in front, each serverless instance should hold exactly one connection.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler, port 5432. Migrations only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth (Project Settings → API) ───────────────────────────────────
# The publishable key is public by design — it ships in the browser bundle. It
# is not the service-role key, which this app never needs and must never hold.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Used to build the OAuth redirect. Must match the Site URL in Supabase Auth
# settings, and must be the real origin in production or Google will refuse.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Media encryption ────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# This key wraps every per-file data key. It never leaves the server, is never
# written next to the media, and is never uploaded to the archive. Lose it and
# every archived file becomes permanently unreadable — that is the same
# mechanism the delete button uses on purpose. Back it up somewhere real.
MEDIA_MASTER_KEY=""

# ─── Background tick ─────────────────────────────────────────────────────────
# Bearer token for POST /api/cron/bakchod. Any long random string:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# ─── Storage ─────────────────────────────────────────────────────────────────
# "archive" uploads ciphertext to Internet Archive. "disk" keeps it under
# .storage/ instead — use that offline, or before you have IA keys.
STORAGE_DRIVER="archive"

# Where the writable directories go: .cache/ (plaintext derivatives), .spool/
# (ciphertext awaiting upload), .storage/ (the disk driver's store). Defaults to
# the working directory, which is what you want locally.
#
# In production set this to a mounted persistent volume. A container filesystem is
# wiped on every deploy, and two of those three cannot survive that: the spool is
# the only copy of ciphertext the archive has not accepted yet, and the cache is
# the only servable copy of media until it has.
DATA_DIR=""

# Internet Archive S3-like keys, from https://archive.org/account/s3.php
# Only read when STORAGE_DRIVER=archive.
IA_ACCESS_KEY=""
IA_SECRET_KEY=""
# Item identifiers are prefixed with this. Pick something unique to you —
# identifiers are global across archive.org.
IA_ITEM_PREFIX="rtb-media"

# ─── Calls (optional) ────────────────────────────────────────────────────────
# A TURN relay. STUN gets most pairs of browsers talking directly; the pairs it
# cannot are behind NAT that only a relay can cross. Without this, calls between
# two awkward networks fail to connect — they are still always offered.
# A relay carries the whole call, so its bandwidth is billed to whoever runs it.
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ─── AI bakchod ──────────────────────────────────────────────────────────────
# Optional. Without a key the bot still posts and comments, from the scripted
# Hinglish pool instead of the model.
ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5. Set claude-haiku-4-5 for the cheaper tier.
BAKCHOD_MODEL="claude-opus-5"
