# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and is meant to be committed.
!.env.example

# Runtime data. All three live under DATA_DIR (default: the repo root).
#
# .cache holds *decrypted* user uploads — and the archive ciphertext too when
# STORAGE_DRIVER=disk. .spool holds ciphertext waiting to be uploaded, which is
# the only copy of it until the archive confirms receipt. .storage is what the
# disk driver uses in place of archive.org. None of it belongs in git.
/.cache/
/.spool/
/.storage/

# Dev server log, appended to by `npm run dev`. Holds whatever the app printed,
# which on a bad startup includes connection strings.
dev.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
